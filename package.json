{
  "name": "imagelab",
  "version": "0.1.0",
  "private": true,
  "description": "ImageLAB · 本地图像设计工具箱（开源方案整合）",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-static.mjs && node scripts/build-psychos.mjs",
    "serve": "node scripts/serve.mjs --root dist --port 4890 --open",
    "preview": "vite preview --host 127.0.0.1 --port 4890",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test": "node --test tools/texture/tests.test.cjs tools/texture/curve.test.cjs && node scripts/check.mjs",
    "smoke": "node tests/smoke.mjs",
    "check": "node scripts/check.mjs",
    "licenses": "node scripts/collect-licenses.mjs"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.81",
    "@visant/extrude3d": "0.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0",
    "vite": "^7.0.0"
  }
}
